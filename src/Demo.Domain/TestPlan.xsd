<?xml version="1.0" encoding="utf-8"?>
<!-- Schema for TestBench plan files (plans/*.xml). Structure only; ranges, units and
     known measurements are checked by TestPlanXml.Validate against the bench. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:simpleType name="DoubleList">
    <xs:restriction>
      <xs:simpleType>
        <xs:list itemType="xs:double"/>
      </xs:simpleType>
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Parameter">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Temperature"/>
      <xs:enumeration value="SupplyVoltage"/>
      <xs:enumeration value="LoadCurrent"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="TestPlan">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Conditions">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Sweep" minOccurs="1" maxOccurs="3">
                <xs:complexType>
                  <xs:attribute name="parameter" type="Parameter" use="required"/>
                  <xs:attribute name="units" type="xs:string" use="required"/>
                  <xs:attribute name="values" type="DoubleList" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Samples">
          <xs:complexType>
            <xs:attribute name="count" type="xs:positiveInteger" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="Tests">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Test" minOccurs="1" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="id" type="xs:string" use="required"/>
                  <xs:attribute name="name" type="xs:string" use="required"/>
                  <xs:attribute name="units" type="xs:string" use="required"/>
                  <xs:attribute name="min" type="xs:double" use="optional"/>
                  <xs:attribute name="max" type="xs:double" use="optional"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="id" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="TP-[0-9]{1,9}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="device" type="xs:string" use="required"/>
      <xs:attribute name="created" type="xs:dateTime" use="required"/>
      <xs:attribute name="source" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
