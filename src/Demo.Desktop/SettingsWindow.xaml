<Window x:Class="Demo.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="620" Height="640" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="White" AutomationProperties.AutomationId="SettingsWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Margin="12,12,12,0" AutomationProperties.AutomationId="SettingsTabs">
            <!-- ============================ AI assistant ============================ -->
            <TabItem Header="  AI assistant  " AutomationProperties.AutomationId="AiTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,14">
                        <CheckBox IsChecked="{Binding ChatEnabled}" FontWeight="SemiBold" FontSize="14"
                                  AutomationProperties.AutomationId="ChatEnabledCheckBox" Content="Enable the AI assistant"/>
                        <Border Background="#F6F7F9" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}">
                                When enabled, the questions you type and the work-order and parts data needed to answer them are sent to the AI provider you choose below.
                                Usage is billed to <Run FontWeight="SemiBold">your</Run> provider account. Nothing is sent until you enable this and send a message.
                                The assistant asks for your approval before changing any data.
                            </TextBlock>
                        </Border>

                        <TextBlock Text="PROVIDER" Style="{StaticResource SectionLabel}" Margin="0,16,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Anthropic (Claude)" IsChecked="True" Margin="0,0,20,0" GroupName="provider"/>
                            <RadioButton Content="OpenAI" IsChecked="{Binding UseOpenAI}" GroupName="provider"
                                         AutomationProperties.AutomationId="OpenAIRadio"/>
                        </StackPanel>

                        <TextBlock Text="MODEL" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left"/>

                        <TextBlock Text="CREDENTIALS" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" Margin="0,0,6,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCredential}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Good}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CredentialDescription}" AutomationProperties.AutomationId="CredentialDescription"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding UserKeysAllowed, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Remove" Margin="6,0,0,0"
                                        Command="{Binding RemoveKeyCommand}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Save key" Margin="6,0,0,0"
                                        Click="SaveKey_Click"/>
                                <PasswordBox x:Name="KeyBox" Padding="4,3" AutomationProperties.AutomationId="ApiKeyBox"/>
                            </DockPanel>
                            <TextBlock Margin="0,4,0,0" FontSize="11.5">
                                <Hyperlink Command="{Binding OpenKeyPageCommand}"><Run Text="{Binding KeyHelpText, Mode=OneWay}"/></Hyperlink>
                                <Run Foreground="{StaticResource Muted}" Text=" · stored encrypted for your Windows account only"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource PlainButton}" Content="Test connection" Command="{Binding TestConnectionCommand}"/>
                            <TextBlock Text="{Binding TestResult}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="380"/>
                        </StackPanel>

                        <TextBlock Text="SPENDING LIMIT PER CHAT (USD, ESTIMATED)" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding SpendCap}" Width="80"/>
                            <TextBlock Text="Leave empty for no limit." Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ Agent access ============================ -->
            <TabItem Header="  Agent access (MCP)  " AutomationProperties.AutomationId="McpTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,14">
                        <CheckBox IsChecked="{Binding McpEnabled}" FontWeight="SemiBold" FontSize="14"
                                  AutomationProperties.AutomationId="McpEnabledCheckBox" Content="Let coding agents connect to this app"/>
                        <Border Background="#F6F7F9" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}">
                                For users of Claude Code, Codex and other MCP-capable agents. The agent uses its own AI subscription; this app needs no key.
                                The server listens on this computer only (127.0.0.1) and requires the access token below.
                            </TextBlock>
                        </Border>

                        <CheckBox IsChecked="{Binding McpAllowWrites}" Margin="0,14,0,0" AutomationProperties.AutomationId="McpWritesCheckBox"
                                  Content="Allow agents to make changes (otherwise read-only)"/>

                        <TextBlock Text="PORT" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding McpPort}" Width="80" HorizontalAlignment="Left"/>

                        <TextBlock Text="ACCESS TOKEN" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MaskedToken}" FontFamily="Consolas" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource PlainButton}" Content="Regenerate" Margin="12,0,0,0" Padding="8,3"
                                    Command="{Binding RegenerateTokenCommand}"/>
                        </StackPanel>

                        <TextBlock Text="CONNECT YOUR AGENT" Style="{StaticResource SectionLabel}"/>
                        <WrapPanel>
                            <Button Style="{StaticResource PlainButton}" Content="Copy for Claude Code" Margin="0,0,8,6" Command="{Binding CopyClaudeCodeCommand}"/>
                            <Button Style="{StaticResource PlainButton}" Content="Copy for Codex" Margin="0,0,8,6" Command="{Binding CopyCodexCommand}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding CopyResult}" Foreground="{StaticResource Good}" TextWrapping="Wrap"/>

                        <TextBlock Text="CONSOLE TOOL (NO APP RUNNING NEEDED)" Style="{StaticResource SectionLabel}" Margin="0,18,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}">
                            Agents can also launch the console tool directly; it speaks MCP over stdin/stdout:
                        </TextBlock>
                        <TextBox Text="{Binding CliPath, Mode=OneWay, StringFormat='{}{0} mcp'}" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <Button Style="{StaticResource PlainButton}" Content="Copy console-tool command for Claude Code" Margin="0,6,0,0" HorizontalAlignment="Left"
                                Command="{Binding CopyCliClaudeCodeCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
            <Button Style="{StaticResource PlainButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Save" Click="Save_Click" AutomationProperties.AutomationId="SaveSettingsButton"/>
        </StackPanel>
    </Grid>
</Window>
