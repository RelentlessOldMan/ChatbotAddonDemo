<Window x:Class="Demo.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="620" Height="660" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="White" AutomationProperties.AutomationId="SettingsWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Margin="12,12,12,0" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="SettingsScroller">
                    <StackPanel Margin="18,14">
                        <CheckBox IsChecked="{Binding ChatEnabled}" FontWeight="SemiBold" FontSize="14"
                                  AutomationProperties.AutomationId="ChatEnabledCheckBox" Content="Enable the AI assistant"/>
                        <Border Background="#F6F7F9" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}">
                                When enabled, the questions you type and the plans, results and spec-sheet data needed to answer them are sent to the AI provider you choose below.
                                Usage is billed to <Run FontWeight="SemiBold">your</Run> provider account. Nothing is sent until you enable this and send a message.
                                The assistant asks for your approval before it creates files or uses the test bench.
                            </TextBlock>
                        </Border>

                        <TextBlock Text="PROVIDER" Style="{StaticResource SectionLabel}" Margin="0,16,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Anthropic (Claude)" IsChecked="True" Margin="0,0,20,0" GroupName="provider"/>
                            <RadioButton Content="OpenAI" IsChecked="{Binding UseOpenAI}" GroupName="provider"
                                         AutomationProperties.AutomationId="OpenAIRadio"/>
                        </StackPanel>

                        <TextBlock Text="MODEL" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left"/>

                        <TextBlock Text="CREDENTIALS" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" Margin="0,0,6,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCredential}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Good}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CredentialDescription}" AutomationProperties.AutomationId="CredentialDescription"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding UserKeysAllowed, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEditKey}" Margin="0,8,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Remove" Margin="6,0,0,0"
                                        Command="{Binding RemoveKeyCommand}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Save key" Margin="6,0,0,0"
                                        Click="SaveKey_Click"/>
                                <PasswordBox x:Name="KeyBox" Padding="4,3" AutomationProperties.AutomationId="ApiKeyBox"/>
                            </DockPanel>
                            <TextBlock Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap">
                                <Hyperlink Command="{Binding OpenKeyPageCommand}"><Run Text="{Binding KeyHelpText, Mode=OneWay}"/></Hyperlink>
                                <Run Foreground="{StaticResource Muted}" Text=" · stored encrypted for your Windows account only"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource PlainButton}" Content="Test connection" Command="{Binding TestConnectionCommand}"/>
                            <TextBlock Text="{Binding TestResult}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="380"/>
                        </StackPanel>

                        <TextBlock Text="SPENDING LIMIT PER CHAT (USD, ESTIMATED)" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding SpendCap, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                     AutomationProperties.AutomationId="SpendCapBox"/>
                            <TextBlock Text="Leave empty for no limit." Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SpendCapError}" Foreground="{StaticResource Bad}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding SpendCapError, Converter={StaticResource NonEmptyToVis}}"
                                   AutomationProperties.AutomationId="SpendCapError"/>

                        <TextBlock Text="OTHER MCP SERVERS FOR THE ASSISTANT" Style="{StaticResource SectionLabel}" Margin="0,22,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}">
                            The assistant can also use the tools of other MCP servers, such as Perforce, GitHub or Microsoft 365. Give each a short name,
                            and the command that starts it or its https address. It asks before every use of their tools.
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding PolicyServers}" Margin="0,6,0,0" Visibility="{Binding HasPolicyServers, Converter={StaticResource BoolToVis}}"
                                      AutomationProperties.AutomationId="PolicyServers">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='Set up by your IT department · {0}'}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding UserServersAllowed, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding McpServers}" Margin="0,6,0,0" AutomationProperties.AutomationId="McpServerList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Remove" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.RemoveServerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" AutomationProperties.AutomationId="RemoveServerButton"/>
                                            <TextBox DockPanel.Dock="Left" Width="110" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="A short name, e.g. github" AutomationProperties.Name="Server name" AutomationProperties.AutomationId="ServerNameBox"/>
                                            <TextBox Margin="6,0,0,0" Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="The command that starts it, or its https address" AutomationProperties.Name="Server command or address" AutomationProperties.AutomationId="ServerCommandBox"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource PlainButton}" Content="Add a server" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Command="{Binding AddServerCommand}" AutomationProperties.AutomationId="AddServerButton"/>
                            <TextBlock Text="{Binding McpServersError}" Foreground="{StaticResource Bad}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding McpServersError, Converter={StaticResource NonEmptyToVis}}"
                                       AutomationProperties.AutomationId="McpServersError"/>
                        </StackPanel>
                        <TextBlock Text="Your IT department allows only the servers it set up." Foreground="{StaticResource Muted}" Margin="0,6,0,0"
                                   Visibility="{Binding UserServersBlocked, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="CODING AGENTS" Style="{StaticResource SectionLabel}" Margin="0,22,0,4"/>
                        <CheckBox IsChecked="{Binding AgentsEnabled}" IsEnabled="{Binding CanChangeAgents}" FontWeight="SemiBold"
                                  AutomationProperties.AutomationId="AgentsEnabledCheckBox" Content="Let coding agents connect to this window"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0">
                            Claude Code, Codex and other agents can then work with the plans and the bench you have open here. They use their own AI
                            and their own account, not this assistant or its key, and don't need it turned on. Set the agent up to start
                            <Run FontFamily="Consolas" Foreground="{StaticResource Chrome}">demo-desktop.exe mcp</Run>; it asks you here before it creates
                            files or uses the bench. See "Connecting a coding agent" in the docs.
                        </TextBlock>
                        <TextBlock Text="Your IT department has turned this off." Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                                   Visibility="{Binding AgentsBlockedByPolicy, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
            <Button Style="{StaticResource PlainButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Save" Click="Save_Click" IsEnabled="{Binding CanSave}" AutomationProperties.AutomationId="SaveSettingsButton"/>
        </StackPanel>
    </Grid>
</Window>
