<Window x:Class="Demo.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Demo.Desktop"
        xmlns:domain="clr-namespace:Demo.Domain;assembly=Demo.Domain"
        Title="{Binding Title}" Width="1480" Height="820" MinWidth="1000" MinHeight="600"
        Background="{StaticResource Surface}" WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="MainWindow">
    <Window.Resources>
        <DataTemplate DataType="{x:Type domain:Finding}">
            <DockPanel Margin="0,0,0,8">
                <Border DockPanel.Dock="Left" CornerRadius="3" Padding="6,1" Margin="0,1,8,0" VerticalAlignment="Top" MinWidth="58">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#E5E7EB"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Fail"><Setter Property="Background" Value="#FDE2E2"/></DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter Property="Background" Value="{StaticResource WarnSoft}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"/>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource Chrome}">
            <DockPanel Margin="16,0" LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⏚" Foreground="#93C5FD" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChromeButton}" Command="{Binding ToggleChatCommand}"
                            Visibility="{Binding IsChatAvailable, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="AssistantButton" Content="✦  Assistant"/>
                    <Button Style="{StaticResource ChromeButton}" Command="{Binding OpenSettingsCommand}"
                            AutomationProperties.AutomationId="SettingsButton" Content="Settings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body: the legacy UI on the left, the (opt-in) assistant on the right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TabControl Margin="12" SelectedIndex="{Binding SelectedTabIndex}" Padding="0" BorderBrush="{StaticResource Border}">

                <!-- ============================== Test plans ============================== -->
                <TabItem Header="  Test plans  " AutomationProperties.AutomationId="PlansTab">
                    <Grid Background="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="400"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,8">
                                <Button Style="{StaticResource PlainButton}" Content="Import plan XML…" HorizontalAlignment="Left" Command="{Binding ImportPlanCommand}"/>
                            </Border>
                            <DataGrid ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" BorderThickness="0"
                                      AutomationProperties.AutomationId="PlansGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Plan" Binding="{Binding Id}" Width="70"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="180"/>
                                    <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="80"/>
                                    <DataGridTextColumn Header="Units" Binding="{Binding Samples}" Width="50"/>
                                    <DataGridTextColumn Header="Measurements" Binding="{Binding MeasurementCount}" Width="95"/>
                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="170"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <Border Grid.Column="1" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0" Padding="16">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="SELECTED PLAN" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedPlan.Id, FallbackValue='—'}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedPlan.Name}" TextWrapping="Wrap"/>
                                    <TextBlock Text="CONDITIONS" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding PlanConditions}" TextWrapping="Wrap" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="▶  Run on bench" Command="{Binding RunPlanCommand}"
                                                AutomationProperties.AutomationId="RunPlanButton"/>
                                        <TextBlock Text="{Binding PlanEstimate}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Width="230"/>
                                    </StackPanel>
                                    <TextBlock Text="PLAN FILE (XML)" Style="{StaticResource SectionLabel}" Margin="0,16,0,4"/>
                                </StackPanel>
                                <TextBox Text="{Binding PlanXml, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F8F9FB"
                                         AutomationProperties.AutomationId="PlanXml"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ================================= Runs ================================= -->
                <TabItem Header="  Runs  " AutomationProperties.AutomationId="RunsTab">
                    <Grid Background="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="560"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" BorderThickness="0"
                                  AutomationProperties.AutomationId="RunsGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Run" Binding="{Binding Id}" Width="62"/>
                                <DataGridTextColumn Header="Plan" Binding="{Binding PlanId}" Width="66"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="82"/>
                                <DataGridTemplateColumn Header="Progress" Width="*" MinWidth="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ProgressBar Value="{Binding PercentComplete, Mode=OneWay}" Maximum="100" Height="8" Margin="4,0" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Failed" Binding="{Binding Failed}" Width="52"/>
                                <DataGridTextColumn Header="Started" Binding="{Binding Started, StringFormat=MM-dd HH:mm}" Width="82"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Column="1" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0" Padding="16,12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,2" VerticalAlignment="Top"
                                                Visibility="{Binding RunVerdict, Converter={StaticResource NonEmptyToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Good}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RunVerdict}" Value="FAIL"><Setter Property="Background" Value="{StaticResource Bad}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding RunVerdict}" Value="PASS WITH WARNINGS"><Setter Property="Background" Value="{StaticResource Warn}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding RunVerdict}" Foreground="White" FontWeight="SemiBold" FontSize="11.5"
                                                       AutomationProperties.AutomationId="RunVerdict"/>
                                        </Border>
                                        <TextBlock Text="{Binding RunHeadline}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Style="{StaticResource PlainButton}" Content="Write report" Margin="0,0,8,0" Command="{Binding WriteReportCommand}"/>
                                        <Button Style="{StaticResource PlainButton}" Content="Open folder" Margin="0,0,8,0" Command="{Binding OpenRunFolderCommand}"/>
                                        <Button Style="{StaticResource PlainButton}" Content="Cancel run" Command="{Binding CancelRunCommand}"/>
                                    </WrapPanel>

                                    <TextBlock Text="KEY FINDINGS" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
                                    <ItemsControl ItemsSource="{Binding Findings}" AutomationProperties.AutomationId="FindingsList"/>

                                    <DockPanel Margin="0,8,0,4">
                                        <TextBlock Text="PLOT" Style="{StaticResource SectionLabel}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding PlotNames}" SelectedItem="{Binding SelectedPlotName}" Width="140" HorizontalAlignment="Left"
                                                  AutomationProperties.AutomationId="PlotPicker"/>
                                    </DockPanel>
                                    <Image Source="{Binding PlotImage}" Stretch="Uniform" MaxHeight="300" HorizontalAlignment="Left"
                                           AutomationProperties.AutomationId="PlotImage"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============================== Spec sheets ============================= -->
                <TabItem Header="  Spec sheets  " AutomationProperties.AutomationId="SpecsTab">
                    <Grid Background="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding Specs}" SelectedItem="{Binding SelectedSpec}" BorderThickness="0"
                                  AutomationProperties.AutomationId="SpecsGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*"/>
                                <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Column="1" ItemsSource="{Binding SelectedSpec.Parameters}" BorderThickness="1,0,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="90"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Units" Binding="{Binding Units}" Width="60"/>
                                <DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="70"/>
                                <DataGridTextColumn Header="Typ" Binding="{Binding Typical}" Width="70"/>
                                <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- The AI side: coding agents working with this window (when allowed), then the assistant (when opted in) -->
            <Grid Grid.Column="1" Width="400" Background="{StaticResource Panel}"
                  Visibility="{Binding IsSidePanelVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <local:AgentPanel DataContext="{Binding Agents}"
                                  Visibility="{Binding DataContext.IsAgentPanelVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <local:AgentPanel.Style>
                        <Style TargetType="local:AgentPanel">
                            <!-- Alone: the whole column, so its list scrolls and a new card is never out of reach -->
                            <Setter Property="Grid.RowSpan" Value="2"/>
                            <Style.Triggers>
                                <!-- Shares the column with the chat: a third of it, scrolling, so the chat stays usable -->
                                <DataTrigger Binding="{Binding DataContext.IsChatVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="MaxHeight" Value="260"/>
                                    <Setter Property="Grid.RowSpan" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:AgentPanel.Style>
                </local:AgentPanel>
                <local:ChatPanel Grid.Row="1" DataContext="{Binding Chat}"
                                 Visibility="{Binding DataContext.IsChatVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#E9ECF0" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0" LastChildFill="False">
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11.5"
                           Text="{Binding Workspace, StringFormat='Workspace: {0}'}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#9CA3AF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BenchBusy}" Value="True">
                                        <Setter Property="Fill" Value="#F59E0B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding BenchStatus}" FontSize="11.5" AutomationProperties.AutomationId="BenchStatus"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
