<UserControl x:Class="Demo.Desktop.AgentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="AgentPanel">
    <UserControl.Resources>
        <ResourceDictionary Source="ChatItemTemplates.xaml"/>
    </UserControl.Resources>

    <!-- Coding agents connected to this app: what they looked at, and their changes waiting for the user's approval -->
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,1">
        <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Clear" Padding="8,3" VerticalAlignment="Top"
                            Command="{Binding ClearCommand}"/>
                    <StackPanel>
                        <TextBlock Text="Coding agents" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="AgentStatus"/>
                        <Button Style="{StaticResource PlainButton}" Content="Try again" Padding="8,3" Margin="0,6,0,0" HorizontalAlignment="Left"
                                Command="{Binding TryAgainCommand}" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="AgentTryAgain"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="14,4">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="2,8,2,4" FontSize="12">
                        Claude Code, Codex and other agents can work with this window: set one up to start
                        <Run FontFamily="Consolas" Foreground="{StaticResource Chrome}">demo-desktop.exe mcp</Run>.
                        They look things up on their own, but ask here before they create files or use the bench.
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Items}" AutomationProperties.AutomationId="AgentTranscript"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
