<UserControl x:Class="Demo.Desktop.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Demo.Desktop.ViewModels"
             AutomationProperties.AutomationId="ChatPanel">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:UserItem}">
            <Border Background="{StaticResource Accent}" CornerRadius="10,10,2,10" Padding="10,7" Margin="48,6,0,6" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Text}" Foreground="White" TextWrapping="Wrap"/>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AssistantItem}">
            <Border Background="#F1F3F6" CornerRadius="10,10,10,2" Padding="10,7" Margin="0,6,32,6" HorizontalAlignment="Left">
                <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                         AutomationProperties.AutomationId="AssistantMessage"/>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ToolItem}">
            <StackPanel Orientation="Horizontal" Margin="4,2" ToolTip="{Binding Name}">
                <TextBlock Text="⚙" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Title}" Foreground="{StaticResource Muted}" FontSize="12"/>
                <TextBlock Text="  ✓" Foreground="{StaticResource Good}" FontSize="12"
                           Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ApprovalItem}">
            <Border Background="{StaticResource WarnSoft}" BorderBrush="#F2C46D" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,6"
                    AutomationProperties.AutomationId="ApprovalCard">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Warn}" FontWeight="SemiBold" Text="The assistant wants to make a change"/>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding Details}" FontFamily="Consolas" FontSize="12" Foreground="#333"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource PrimaryButton}" Background="{StaticResource Good}" Content="Approve"
                                Command="{Binding ApproveCommand}" AutomationProperties.AutomationId="ApproveButton"/>
                        <Button Style="{StaticResource PlainButton}" Content="Deny" Margin="8,0,0,0"
                                Command="{Binding DenyCommand}" AutomationProperties.AutomationId="DenyButton"/>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Approved">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Foreground" Value="{StaticResource Good}"/>
                                        <Setter Property="Text" Value="✓ Approved by you"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Denied">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Foreground" Value="{StaticResource Bad}"/>
                                        <Setter Property="Text" Value="✕ Denied by you, nothing was changed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NoticeItem}">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontStyle="Italic" Margin="4,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Bad}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: who we're talking to and who pays -->
            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="New chat" Padding="8,3" VerticalAlignment="Top"
                            Command="{Binding NewChatCommand}"/>
                    <StackPanel>
                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding ConnectionDescription}" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ChatConnection"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Transcript, or the setup card when no credentials are configured -->
            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,6">
                <StackPanel>
                    <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="14" Margin="0,8"
                            Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Connect an AI provider" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,10"
                                       Text="The assistant uses your own Anthropic or OpenAI account, so usage is billed to you by the provider. Add an API key in Settings, or ask your IT team about your organization's AI gateway."/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Open settings" HorizontalAlignment="Left"
                                    Command="{Binding OpenSettingsCommand}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="2,10,2,4">
                        Ask about work orders and parts in plain English. The assistant can look things up on its own, but it will ask before changing anything.
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Items}" AutomationProperties.AutomationId="Transcript"/>
                    <TextBlock Text="{Binding Activity}" Foreground="{StaticResource Muted}" FontStyle="Italic" Margin="4,6"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Input + usage meter -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,10">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Send" Margin="8,0,0,0"
                                Command="{Binding SendCommand}" IsDefault="True" AutomationProperties.AutomationId="SendButton"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Stop" Margin="8,0,0,0"
                                Command="{Binding StopCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" TextWrapping="Wrap" MaxHeight="90"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ChatInput"/>
                    </DockPanel>
                    <TextBlock Text="{Binding UsageSummary}" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,6,0,0"
                               AutomationProperties.AutomationId="UsageSummary"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
