<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same driver the screenshot tool uses. -->
    <Compile Include="..\..\tools\Demo.Screenshots\DesktopDriver.cs" Link="DesktopDriver.cs" />
    <ProjectReference Include="..\..\src\Demo.Ai\Demo.Ai.csproj" />
    <!-- Build order only: the tests launch the app's exe. -->
    <ProjectReference Include="..\..\src\Demo.Desktop\Demo.Desktop.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Demo.Cli\Demo.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
