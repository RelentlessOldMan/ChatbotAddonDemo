<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows: path D1 reaches the desktop app over a Windows named pipe. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel, for the fake AI gateway on 127.0.0.1. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Demo.Ai\Demo.Ai.csproj" />
    <!-- The hub (paths C and D1) and the MCP client. -->
    <ProjectReference Include="..\..\src\Demo.Mcp\Demo.Mcp.csproj" />
    <!-- Build order only: paths B and D2 start the real demo-cli.exe, and D1 the real demo-desktop.exe, from their own folders (see Paths.cs). -->
    <ProjectReference Include="..\..\src\Demo.Cli\Demo.Cli.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Demo.Desktop\Demo.Desktop.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
